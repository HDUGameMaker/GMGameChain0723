-/**
- * 通过 HTTP 目录列表实时扫描 assets/ 目录
- * http-server 默认开启目录浏览，返回的 HTML 中包含 <a> 链接
- */
-async function scanAssetsViaHTTP() {
-  const ASSET_DIRS = ['buildings', 'resources', 'items', 'ui', 'expeditions'];
-  const IMG_EXTS = ['.png', '.jpg', '.jpeg', '.webp', '.gif', '.svg', '.bmp'];
-  const allFiles = [];
-  const categories = {};
-
-  for (const dir of ASSET_DIRS) {
-    try {
-      const resp = await fetch(`assets/${dir}/`);
-      if (!resp.ok) continue;
-      const html = await resp.text();
-      // 解析 http-server 目录列表 HTML：<a href="./filename.png">filename</a>
-      const linkRe = /<a\s+href="\.\/([^"]+)"/gi;
-      let match;
-      const dirFiles = [];
-      while ((match = linkRe.exec(html)) !== null) {
-        const name = match[1];
-        // 跳过父目录链接
-        if (name === '../') continue;
-        const ext = '.' + name.split('.').pop().toLowerCase();
-        if (IMG_EXTS.includes(ext)) {
-          const relPath = `${dir}/${name}`;
-          dirFiles.push(relPath);
-          allFiles.push(relPath);
-        }
-      }
-      if (dirFiles.length > 0) {
-        categories[dir] = dirFiles;
-      }
-    } catch(e) {
-      // 目录不存在或无法访问，跳过
-    }
-  }
-
-  if (allFiles.length > 0) {
-    state.manifest = {
-      generated: new Date().toISOString(),
-      basePath: 'assets/',
-      totalFiles: allFiles.length,
-      categories,
-      files: allFiles,
-      _scanned: true  // 标记为实时扫描
-    };
-    document.getElementById('bottomRight').textContent =
-      `素材清单: ${allFiles.length} 个文件 (实时扫描)`;
-  } else {
-    state.manifest = null;
-    document.getElementById('bottomRight').textContent =
-      '素材清单未找到（运行 node scripts/generate-asset-manifest.js 生成）';
-  }
-}
