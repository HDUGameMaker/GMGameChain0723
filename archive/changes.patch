+        'gridHeight': height,
+        'tileSize': tile_size,
+        'groundTypes': ground_types,
+        'grid': grid,
+        'expeditionEntrances': [],
+        'initialBuildings': [],
+        'viewportCenter': {
+            'defaultGridX': width // 2,
+            'defaultGridY': height // 2,
+            'useLastSavedPosition': True
+        }
+    }
+    
