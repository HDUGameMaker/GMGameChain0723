-function updateLabelPreview() {
-  const canvas = document.getElementById('labelCanvas');
-  if (!canvas) return;
-  const ctx = canvas.getContext('2d');
-  const W = canvas.width, H = canvas.height;
-
-  ctx.clearRect(0, 0, W, H);
-
-  const b = state.data.buildings[state.labelBuildingIdx];
-  if (!b) return;
-  ensureLayoutDefaults(b);
-  const ll = b.labelLayout;
-  const ml = b.mapIconLayout;
-  const dl = b.detailLayout;
-
-  const footW = b.footprint?.width || 1;
-  const footH = b.footprint?.height || 1;
-
-  // ── Layout: two side-by-side zones ──
-  const dividerX = 210;
-  const mapCX = 105;
-
-  // Vertical divider
-  ctx.strokeStyle = '#d5d0c8';
-  ctx.lineWidth = 1;
-  ctx.setLineDash([4, 4]);
-  ctx.beginPath(); ctx.moveTo(dividerX, 20); ctx.lineTo(dividerX, H - 20); ctx.stroke();
-  ctx.setLineDash([]);
-
-  // Zone labels
-  ctx.fillStyle = '#6b6964';
-  ctx.font = '11px -apple-system, "Microsoft YaHei", sans-serif';
-  ctx.textAlign = 'center';
-  ctx.fillText('🗺️ 地图视图', mapCX, 30);
-  ctx.fillText('🖼️ 详情弹窗预览', dividerX + (W - dividerX) / 2, 30);
-
-  // ════════════════════════════════════════
-  // Zone 1: Map View — fixed tile size so size differences are visible
-  // ════════════════════════════════════════
-  const tilePx = Math.min(36, 130 / Math.max(footW, footH));
-  const mscW = footW * tilePx, mscH = footH * tilePx;
-  const mox = mapCX - mscW / 2, moy = 100 - mscH / 2;
-
-  // Ground tile
-  ctx.fillStyle = '#c8d6a0';
-  ctx.strokeStyle = '#9aab7c';
-  ctx.lineWidth = 1.5;
-  ctx.beginPath();
-  ctx.roundRect(mox, moy, mscW, mscH, 3);
-  ctx.fill();
-  ctx.stroke();
-
-  // Grid lines for multi-tile
-  if (footW > 1 || footH > 1) {
-    ctx.strokeStyle = 'rgba(154,171,124,0.4)';
-    ctx.lineWidth = 0.5;
-    for (let tx = 1; tx < footW; tx++) {
-      const gx = mox + tx * tilePx;
-      ctx.beginPath(); ctx.moveTo(gx, moy); ctx.lineTo(gx, moy + mscH); ctx.stroke();
-    }
-    for (let ty = 1; ty < footH; ty++) {
-      const gy = moy + ty * tilePx;
-      ctx.beginPath(); ctx.moveTo(mox, gy); ctx.lineTo(mox + mscW, gy); ctx.stroke();
-    }
-  }
-
-  // Size badge
-  ctx.fillStyle = '#6b6964';
-  ctx.font = '9px monospace';
-  ctx.textAlign = 'center';
-  ctx.fillText(footW + '×' + footH + ' (' + (footW * 64) + '×' + (footH * 64) + 'px)', mapCX, moy + mscH + 14);
-
-  // Map icon with scale/offset
-  const miOX = ml.offsetX * (tilePx / 64);
-  const miOY = ml.offsetY * (tilePx / 64);
-  const miW = mscW * ml.scaleX, miH = mscH * ml.scaleY;
-  const miX = mox + (mscW - miW) / 2 + miOX;
-  const miY = moy + (mscH - miH) / 2 + miOY;
-
-  ctx.save();
-  ctx.beginPath();
-  ctx.roundRect(miX, miY, miW, miH, 2);
-  ctx.clip();
-  const cs = 6;
-  for (let gy = miY; gy < miY + miH; gy += cs) {
-    for (let gx = miX; gx < miX + miW; gx += cs) {
-      const even = (Math.floor(gx / cs) + Math.floor(gy / cs)) % 2 === 0;
-      ctx.fillStyle = even ? '#e8e4dc' : '#ffffff';
-      ctx.fillRect(gx, gy, cs, cs);
-    }
-  }
-  ctx.fillStyle = 'rgba(123,94,167,0.45)';
-  ctx.fillRect(miX, miY, miW, miH);
-  ctx.restore();
-  ctx.strokeStyle = '#7b5ea7';
-  ctx.lineWidth = 1.5;
-  ctx.beginPath();
-  ctx.roundRect(miX, miY, miW, miH, 2);
-  ctx.stroke();
-
-  // Map icon info
-  ctx.fillStyle = '#9a80c0';
-  ctx.font = '8px monospace';
-  ctx.fillText('s:' + ml.scaleX.toFixed(1) + '×' + ml.scaleY.toFixed(1), mapCX, moy + mscH + 26);
-
-  // Labels on map
-  const ls = tilePx / 64; // label scale factor
-  const nOff = (ll.nameOffsetY ?? 0) * ls;
-  const pOff = (ll.progressBarOffsetY ?? 0) * ls;
-  const wOff = (ll.workersOffsetY ?? 0) * ls;
-  const mcx = mox + mscW / 2, mcy = moy + mscH / 2;
-
-  // Name
-  const nameFontSize = Math.max(9, Math.round(12 * ls));
-  ctx.fillStyle = '#ffffff';
-  ctx.font = 'bold ' + nameFontSize + 'px -apple-system, "Microsoft YaHei", sans-serif';
-  ctx.textAlign = 'center';
-  ctx.textBaseline = 'middle';
-  ctx.strokeStyle = 'rgba(0,0,0,0.6)';
-  ctx.lineWidth = Math.max(2, 3 * ls);
-  ctx.strokeText(b.name || '(名称)', mcx, mcy - 10 * ls + nOff);
-  ctx.fillText(b.name || '(名称)', mcx, mcy - 10 * ls + nOff);
-
-  // Progress bar
-  if (footW === 1 && footH === 1) {
-    const pbY = mcy + 2 + pOff;
-    const pbW = mscW * 0.65, pbH = Math.max(2, 3 * ls);
-    ctx.fillStyle = 'rgba(0,0,0,0.5)';
-    ctx.fillRect(mcx - pbW / 2, pbY - pbH / 2, pbW, pbH);
-    ctx.fillStyle = '#4a7c59';
-    ctx.fillRect(mcx - pbW / 2, pbY - pbH / 2, pbW * 0.6, pbH);
-  }
-
-  // Workers
-  const wY = moy + mscH - 6 * ls + wOff;
-  ctx.fillStyle = '#ffffff';
-  ctx.font = Math.round(10 * ls) + 'px -apple-system, sans-serif';
-  ctx.strokeStyle = 'rgba(0,0,0,0.5)';
-  ctx.lineWidth = Math.max(1.5, 2 * ls);
-  ctx.strokeText('👷 1', mcx, wY);
-  ctx.fillText('👷 1', mcx, wY);
-
-  // ════════════════════════════════════════
-  // Zone 2: Detail Popup — game-accurate style
-  // ════════════════════════════════════════
-  const dpX = dividerX + (W - dividerX) / 2;
-  const dpW = 260, dpTop = 52;
-  const dpLeft = dpX - dpW / 2;
-
-  // Glassmorphism popup background
-  const popupGrad = ctx.createLinearGradient(0, dpTop, 0, H - 16);
-  popupGrad.addColorStop(0, 'rgba(22,22,38,0.97)');
-  popupGrad.addColorStop(1, 'rgba(18,18,32,0.97)');
-  ctx.fillStyle = popupGrad;
-  ctx.strokeStyle = 'rgba(255,255,255,0.08)';
-  ctx.lineWidth = 1;
-  ctx.beginPath();
-  ctx.roundRect(dpLeft, dpTop, dpW, H - dpTop - 16, 12);
-  ctx.fill();
-  ctx.stroke();
-
-  // ── Detail image (top area, like the game) ──
-  let curY = dpTop + 12;
-  const imgMaxW = dpW - 40, imgMaxH = 90;
-  const diOX_dp = dl.offsetX;
-  const diOY_dp = dl.offsetY;
-  const diW_dp = imgMaxW * dl.scale, diH_dp = imgMaxH * dl.scale;
-  const imgCX = dpX;
-  const imgCY = curY + imgMaxH / 2;
-  const diX_dp = imgCX - diW_dp / 2 + diOX_dp;
-  const diY_dp = imgCY - diH_dp / 2 + diOY_dp;
-
-  // Image area background
-  ctx.fillStyle = 'rgba(255,255,255,0.03)';
-  ctx.beginPath();
-  ctx.roundRect(dpLeft + 20, curY, dpW - 40, imgMaxH, 8);
-  ctx.fill();
-
-  // Checkerboard placeholder
-  ctx.save();
-  ctx.beginPath();
-  ctx.roundRect(Math.max(dpLeft + 20, diX_dp), Math.max(curY, diY_dp), Math.min(dpW - 40, diW_dp), Math.min(imgMaxH, diH_dp), 4);
-  ctx.clip();
-  const cs2 = 5;
-  for (let gy = diY_dp; gy < diY_dp + diH_dp; gy += cs2) {
-    for (let gx = diX_dp; gx < diX_dp + diW_dp; gx += cs2) {
-      if (gx < dpLeft + 20 || gx > dpLeft + dpW - 20) continue;
-      if (gy < curY || gy > curY + imgMaxH) continue;
-      const even = (Math.floor(gx / cs2) + Math.floor(gy / cs2)) % 2 === 0;
-      ctx.fillStyle = even ? '#3a3a4a' : '#333340';
-      ctx.fillRect(gx, gy, cs2, cs2);
-    }
-  }
-  ctx.fillStyle = 'rgba(160,140,200,0.35)';
-  ctx.fillRect(diX_dp, diY_dp, diW_dp, diH_dp);
